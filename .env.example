# 复制为 .env 后填写（不要提交 .env）
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change_me_blog
REDIS_PASSWORD=change_me_redis
JWT_SECRET=change_me_to_a_long_random_string
# 企业管理系统复用上面的 MySQL 账号，并使用独立的 np 库。部署时会自动建库。
# RAG 智能工单复用同一 MySQL，使用独立的 rag_ticket 库。对话和向量走外部 API。
# 当前默认硅基流动（一家搞定对话 + 向量）；换成别家时同步改 BASE_URL 与模型名。
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_CHAT_MODEL=zai-org/GLM-5.3-Flash
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
