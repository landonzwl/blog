# 依赖目录（npm install 可重建，体积巨大）
node_modules/

# 前端构建产物（npm run build 可重新生成）
dist/

# 后端构建产物
target/

# IDE 配置（每台电脑自动生成）
.idea/
*.iml

# Docker 本地数据（保留 init 与增量迁移 SQL 可提交）
/data/*
!/data/init/
!/data/init/**
!/data/migrate/
!/data/migrate/**

# 环境变量（含密码、JWT 密钥，禁止提交）
.env

# 系统杂项
.DS_Store
Thumbs.db

# RAG 本地工具和内嵌仓库，不进入部署仓库
RAG/.tools/
RAG/RAG/.git/

# 企业管理系统的本地残留，不进入部署仓库
NP/untitled/
NP/task-dump.txt
NP/NPend/
*.mv.db
*.trace.db
